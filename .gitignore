# Dependencies
node_modules/
dist/
build/

# Environment variables
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.claude/
.vscode/
.idea/
*.swp
*.swo

# Database files (changed during runtime)
# Broad pattern first: every *.db under data/ is runtime state, including the
# manual-test and ad-hoc backups that the narrower patterns below missed.
data/*.db
data/*.db-wal
data/*.db-shm
data/warehouse.db
*.sqlite
*.sqlite3

# Database backups
data/*.backup*.db
data/*.old.db
data/*.sample*.db

# Test data (exclude large binary Excel files)
warehouse-source.zip
